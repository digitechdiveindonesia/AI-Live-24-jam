# ==============================================================================
# AI LIVE COMMERCE - ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to .env and populate with your credentials.
# NEVER commit .env or sensitive secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# SUPABASE POSTGRESQL DATABASE (Primary Persistent Source of Truth)
# Current Supabase API Key Model:
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Publishable Key (Client/Browser safe, e.g. sb_pub_... or jwt)
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Supabase Secret Key (SERVER-ONLY - NEVER EXPOSE TO CLIENT BROWSER / REACT)
# Used by backend services, sync workers, and background processors for administrative access.
SUPABASE_SECRET_KEY=your_supabase_secret_key_here

# ------------------------------------------------------------------------------
# AI ENGINE - GOOGLE GEMINI
# ------------------------------------------------------------------------------
# Gemini API Key for conversation, intent classification, and RAG reasoning.
# In Google AI Studio, this is managed via the Secrets Panel.
GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# SERVER & RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
